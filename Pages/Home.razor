<!-- ============================================================
     SKILLS SECTION
     ============================================================ -->
<section id="skills" class="skills-section section section-alt" aria-label="Skills and technologies">
    <div class="container">
        <header class="section-header fade-in-up">
            <span class="section-tag">What I work with</span>
            <h2 class="section-title">My Skills</h2>
            <p class="section-subtitle">Technologies and tools I use to bring ideas to life</p>
        </header>

        <div class="skills-grid">

            <!-- Frontend -->
            <div class="skill-category fade-in-up">
                <div class="skill-category-header">
                    <span class="skill-category-icon" aria-hidden="true">&#127912;</span>
                    <h3>Frontend</h3>
                </div>
                <div class="skill-list">
                    @foreach (var s in frontendSkills)
                    {
                        <SkillBar Name="@s.Name" Percent="@s.Percent" />
                    }
                </div>
            </div>

            <!-- Backend -->
            <div class="skill-category fade-in-up" style="--delay:.1s">
                <div class="skill-category-header">
                    <span class="skill-category-icon" aria-hidden="true">&#9881;&#65039;</span>
                    <h3>Backend</h3>
                </div>
                <div class="skill-list">
                    @foreach (var s in backendSkills)
                    {
                        <SkillBar Name="@s.Name" Percent="@s.Percent" />
                    }
                </div>
            </div>

            <!-- Tools -->
            <div class="skill-category fade-in-up" style="--delay:.2s">
                <div class="skill-category-header">
                    <span class="skill-category-icon" aria-hidden="true">&#128736;&#65039;</span>
                    <h3>Tools &amp; DevOps</h3>
                </div>
                <div class="skill-list">
                    @foreach (var s in toolSkills)
                    {
                        <SkillBar Name="@s.Name" Percent="@s.Percent" />
                    }
                </div>
            </div>
        </div>

        <!-- Tech-tag cloud -->
        <div class="tech-stack fade-in-up">
            <h3 class="tech-stack-title">Technologies I've Worked With</h3>
            <div class="tech-tags" aria-label="Full technology list">
                @foreach (var t in techTags)
                {
                    <span class="tech-tag">@t</span>
                }
            </div>
        </div>
    </div>
</section>

<!-- ============================================================
     PROJECTS SECTION
     ============================================================ -->
