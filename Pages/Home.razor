</section>

<!-- ============================================================
     ABOUT SECTION
     ============================================================ -->
<section id="about" class="about-section section" aria-label="About me">
    <div class="container">
        <header class="section-header fade-in-up">
            <span class="section-tag">Get to know me</span>
            <h2 class="section-title">About Me</h2>
            <p class="section-subtitle">Passionate developer crafting impactful digital experiences</p>
        </header>

