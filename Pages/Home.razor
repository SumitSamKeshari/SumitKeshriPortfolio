            </div>

            <!-- Profile image integration -->
            <div class="hero-image fade-in-right">
                <div class="profile-image-container">
                    <div class="profile-image-placeholder"
                         role="img" aria-label="Sumit Kumar Keshari">
                        <img src="images/SumitPhoto.jpg" alt="Sumit Kumar Keshari" style="width: 100%; height: 100%; object-fit: cover; object-position: center 15%; border-radius: inherit;" />
                    </div>
                    <div class="profile-badge" aria-label="Available for hire">
